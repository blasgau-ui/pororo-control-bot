# Token del bot, lo da @BotFather en Telegram al crear el bot.
TELEGRAM_BOT_TOKEN=

# Mismos valores que usa la web de pororo-control (Project Settings > API en Supabase).
SUPABASE_URL=https://usjywklfswpynvqrhdfn.supabase.co
SUPABASE_ANON_KEY=

# Clave para cifrar en disco las sesiones guardadas (tokens de las cuentas vinculadas).
# Generarla una vez con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# y no cambiarla despues (si cambia, las sesiones guardadas quedan ilegibles y hay que
# volver a hacer /login).
BOT_ENCRYPTION_KEY=

# Ruta del archivo SQLite donde se guardan las sesiones vinculadas. Opcional.
BOT_DB_PATH=bot_sessions.db

# Hora (0-23, huso horario del servidor donde corre el bot) a la que se manda el resumen
# diario a quienes activaron /notificaciones. Opcional, por defecto 20.
DAILY_DIGEST_HOUR=20
